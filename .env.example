# Copy to .env and fill in. Never commit .env.

# LLM (https://console.groq.com/keys)
GROQ_API_KEY=
# GROQ_MODEL=llama-3.3-70b-versatile

# Vector store (https://astra.datastax.com)
ASTRA_DB_API_ENDPOINT=
ASTRA_DB_APPLICATION_TOKEN=
ASTRA_DB_KEYSPACE=default_keyspace
# ASTRA_DB_COLLECTION=Recommendation_chatbot

# Embeddings (https://huggingface.co/settings/tokens)
HF_TOKEN=

# Web app
FLASK_SECRET_KEY=change-me-to-a-long-random-string
# PORT=5000
# LOG_LEVEL=INFO

# Optional: override the dataset location
# PRODUCT_DATA_PATH=data/flipkart_product_review.csv
